{
  "name": "bullseye",
  "version": "0.1.0",
  "description": "A lightweight verification layer for coding agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "bullseye": "./bin/bullseye.mjs"
  },
  "files": [
    ".claude-plugin/",
    ".codex-plugin/",
    ".cursor-plugin/",
    "adapters/",
    "benchmark/README.md",
    "benchmark/fixtures/",
    "benchmark/run.mjs",
    "bin/",
    "hooks/",
    "skills/",
    "src/",
    "LICENSE",
    "plugin.json"
  ],
  "scripts": {
    "benchmark": "node ./benchmark/run.mjs",
    "test": "node --test",
    "validate": "node ./bin/bullseye.mjs validate"
  },
  "cline": {
    "plugins": [
      {
        "paths": ["./adapters/cline.mjs"],
        "capabilities": ["tools", "hooks", "rules"]
      }
    ]
  },
  "peerDependencies": {
    "@cline/core": "*"
  },
  "peerDependenciesMeta": {
    "@cline/core": {
      "optional": true
    }
  }
}
