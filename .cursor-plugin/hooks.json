{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/bin/bullseye.mjs\" hook",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/bin/bullseye.mjs\" hook",
        "matcher": "Shell",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/bin/bullseye.mjs\" hook",
        "timeout": 5,
        "loop_limit": 1
      }
    ],
    "sessionEnd": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/bin/bullseye.mjs\" hook",
        "timeout": 5
      }
    ]
  }
}
