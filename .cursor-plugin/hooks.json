{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/bin/bullseye.mjs\" hook",
        "timeout": 20
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/bin/bullseye.mjs\" hook",
        "timeout": 20
      }
    ],
    "postToolUse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/bin/bullseye.mjs\" hook",
        "matcher": "Shell",
        "timeout": 20
      }
    ],
    "postToolUseFailure": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/bin/bullseye.mjs\" hook",
        "matcher": "Shell",
        "timeout": 20
      }
    ],
    "afterAgentResponse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/bin/bullseye.mjs\" hook",
        "timeout": 20
      }
    ],
    "stop": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/bin/bullseye.mjs\" hook",
        "timeout": 20,
        "loop_limit": 1
      }
    ],
    "sessionEnd": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/bin/bullseye.mjs\" hook",
        "timeout": 3
      }
    ]
  }
}
